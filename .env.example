# Copy this file to ".env" in the same folder, then edit it. Keep .env private.

# --- Live rates (Safari Bullions) ---
LIVE_PROVIDER_NAME=Safari Bullions
LIVE_URL=https://bcast.safaribullions.com/VOTSBroadcastStreaming/Services/xml/GetLiveRateByTemplateID/safari?_=

# Set to "yes" ONLY when you have the provider's permission to use this feed on your shop display.
LIVE_PERMISSION_CONFIRMED=no

# Seconds between requests. Use what the provider allows; 10 is a modest starting value.
LIVE_MIN_INTERVAL_SECONDS=10

# Which row feeds each rate: the row ID, or the row name without its (date).
# Row 2275 = "GOLD INDIAN-BIS 995 1KG". It becomes the 24K base; 22K and 20K are calculated from it.
LIVE_MAP_GOLD24=2275
# Silver comes from a different feed (Kaka Gold, "kakasilverbar"). Row 4642 = "SILVER 999 1KG BAR (KAKA SILVER)".
LIVE_URL_SILVER=https://bcast.kakagold.xyz/VOTSBroadcastStreaming/Services/xml/GetLiveRateByTemplateID/kakasilverbar?_=
LIVE_MAP_SILVER=4642

# Which number on the row to use, counted from 1. 2 = the number your screenshot arrow points at.
LIVE_VALUE_COLUMN=2
